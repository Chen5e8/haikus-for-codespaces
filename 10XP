from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.firefox.service import Service as FirefoxService
from webdriver_manager.firefox import GeckoDriverManager
import time
import random

# Configuration des identifiants (NE PAS stocker les identifiants en clair dans le code)
EMAIL = "austin.cy.chen@gmail.com"
PASSWORD = "saint.germain.78100"

# Configuration du navigateur
options = webdriver.FirefoxOptions()
options.add_argument("--headless")  # Mode invisible
options.set_preference("general.useragent.override", 
                       "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Gecko/20100101 Firefox/98.0")

# Initialisation du WebDriver
driver = webdriver.Firefox(service=FirefoxService(GeckoDriverManager().install()), options=options)
driver.get("https://www.duolingo.com/")

def login():
    """Fonction pour se connecter à Duolingo."""
    time.sleep(random.uniform(3, 5))
    try:
        login_button = driver.find_element(By.XPATH, "//a[contains(text(),'Se connecter')]")
        login_button.click()
        time.sleep(random.uniform(2, 4))

        email_input = driver.find_element(By.NAME, "identifier")
        email_input.send_keys(EMAIL)

        password_input = driver.find_element(By.NAME, "password")
        password_input.send_keys(PASSWORD)
        password_input.send_keys(Keys.RETURN)

        print("[INFO] Connexion réussie !")
        time.sleep(random.uniform(5, 7))

    except Exception as e:
        print(f"[ERREUR] Impossible de se connecter : {e}")
        driver.quit()

def complete_lesson():
    """Fonction pour compléter une leçon."""
    driver.get("https://www.duolingo.com/lesson")
    time.sleep(random.uniform(3, 5))

    for _ in range(10):  # Simule plusieurs interactions
        try:
            # Cherche les boutons de réponse
            buttons = driver.find_elements(By.XPATH, "//button[@data-test='player-next']")
            if buttons:
                buttons[0].click()
                print("[INFO] Réponse validée !")
                time.sleep(random.uniform(2, 4))
            else:
                print("[INFO] Aucune action possible, sortie.")
                break

        except Exception as e:
            print(f"[ERREUR] Problème lors de la leçon : {e}")
            break

def main():
    login()
    while True:
        complete_lesson()
        print("+10 XP obtenus ! ✅")
        time.sleep(random.uniform(50, 70))  # Pause aléatoire entre les leçons

if __name__ == "__main__":
    main()
